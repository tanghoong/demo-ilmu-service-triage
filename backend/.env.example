# ---- ILMU (server-side only; NEVER shipped to the browser) ----
ILMU_API_KEY=sk-your-ilmu-key
ILMU_BASE_URL=https://api.ilmu.ai/v1
ILMU_MODEL=ilmu-chat
ILMU_TIMEOUT_SECONDS=25
ILMU_MAX_RETRIES=2

# Set to 1 to run the whole demo with a deterministic stub (no network, no key).
ILMU_MOCK=0

# ---- App ----
ALLOWED_ORIGINS=http://localhost:5173
RATE_LIMIT_PER_MINUTE=20
AUDIT_LOG_PATH=./audit.log.jsonl
