{
  "name": "ilmu-service-triage",
  "private": true,
  "scripts": {
    "dev": "concurrently -n api,web -c cyan,magenta -k \"npm:dev:api\" \"npm:dev:web\"",
    "setup": "cd backend && python -m venv .venv && (.venv/Scripts/pip.exe install -r requirements.txt || .venv/bin/pip install -r requirements.txt)",
    "dev:api": "cd backend && (.venv/Scripts/python.exe app_run.py || .venv/bin/python app_run.py)",
    "dev:web": "cd frontend && npm run dev"
  },
  "devDependencies": { "concurrently": "^9.1.2" }
}
